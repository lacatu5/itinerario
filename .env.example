# Environment Configuration
ENVIRONMENT=local

# GCP Configuration
GOOGLE_CLOUD_PROJECT=demo-project-id
FIREBASE_PROJECT_ID=demo-project-id
CLOUD_STORAGE_BUCKET=demo-bucket-itinerario

# Emulator Configuration (Local Development)
FIRESTORE_EMULATOR_HOST=firebase-emulator:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
STORAGE_EMULATOR_HOST=localhost:4443

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_NAME=itinerario_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/itinerario_db

# Cloud SQL Configuration (Production)
CLOUD_SQL_CONNECTION_NAME=

# Service Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
WORKERS=1

# AviationStack (Flight Data)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT=15.0

# Open-Meteo (Weather Data)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_AVAILABLE=true
OPEN_METEO_TIMEOUT=10.0

# Feature Flags
# Set to true to use mock data for all external APIs (weather, flights, etc.)
ENABLE_MOCK_DATA=false
ENABLE_HEALTH_CHECKS=true

# Real-time Messaging (Centrifugo)
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=your_api_key_here
CENTRIFUGO_HMAC_SECRET_KEY=your_hmac_secret_here
CENTRIFUGO_WS_URL=ws://localhost:8443/connection/websocket
