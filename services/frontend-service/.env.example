# Frontend Configuration

# API URL (Required in production)
# Development: Uses Vite proxy, can be empty or /
# Production: Must be set to your backend API URL
VITE_API_URL=https://api.yourdomain.com

# Example values:
# Development: VITE_API_URL=/  (uses Vite proxy)
# Production: VITE_API_URL=https://api.itinerario.app

# Optional: Additional frontend configuration
# VITE_APP_TITLE=Itinerario
# VITE_APP_VERSION=1.0.0
